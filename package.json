{
  "name": "changelogen",
  "version": "0.6.2",
  "description": "Generate Beautiful Changelogs using Conventional Commits",
  "repository": "unjs/changelogen",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "changelogen": "./dist/cli.mjs"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "changelogen": "jiti ./src/cli.ts",
    "dev": "vitest dev",
    "lint": "eslint . && prettier -c src test",
    "lint:fix": "eslint --fix . && prettier -w src test",
    "prepack": "obuild",
    "release": "pnpm test && pnpm changelogen --release --push && pnpm publish",
    "test": "pnpm lint && vitest run --coverage"
  },
  "dependencies": {
    "c12": "^4.0.0-rc.1",
    "confbox": "^0.3.1",
    "consola": "^3.4.2",
    "convert-gitmoji": "^0.1.5",
    "open": "^11.0.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.2",
    "scule": "^1.3.0",
    "semver": "^7.8.5",
    "std-env": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-unjs": "^0.6.2",
    "jiti": "^2.7.0",
    "obuild": "^0.4.39",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
